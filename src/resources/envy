#!/usr/bin/env bash
# envy-managed bootstrap script - do not edit
set -euo pipefail

ENVY_DEFAULT_MIRROR="@@DOWNLOAD_URL@@"
ENVY_LATEST_URL="@@LATEST_URL@@"
ENVY_ENV_MIRROR="${ENVY_MIRROR:-}"
ENVY_FALLBACK_VERSION="@@ENVY_VERSION@@"
ENVY_MIN_DIRECTIVE_VERSION="@@MIN_DIRECTIVE_VERSION@@"

resolve_script_dir() {
    local src="${BASH_SOURCE[0]}"
    while [[ -L "$src" ]]; do
        local dir; dir="$(cd -P "$(dirname "$src")" && pwd -P)"
        src="$(readlink "$src")"
        [[ "$src" != /* ]] && src="$dir/$src"
    done
    cd -P "$(dirname "$src")" && pwd -P
}

# Directives from a manifest's header: blank lines and comments, stopping at the first line
# of code. A directive below that line is not one -- parse_envy_meta in src/manifest.cpp
# stops there too, and a launcher that read further would resolve a version or mirror the
# re-exec'd binary ignores. No line cap, deliberately: the header ends where the code
# starts, wherever that is, so a long preamble can never silently drop a pin. `q` bounds the
# read to the header, so file size is irrelevant.
manifest_directives() {
    sed -nE '
        /^[[:space:]]*$/d
        /^[[:space:]]*--/!q
        s/^[[:space:]]*--[[:space:]]*@envy[[:space:]]+(version|cache-local|cache-mode|state-dir|mirror|sha256sums|root)[[:space:]]+"(([^"\\]|\\.)*)".*/\1 \2/p
    ' "$1"
}

find_manifest() {
    local d; d="$(resolve_script_dir)"
    local candidates=()
    while [[ "$d" != / ]]; do
        if [[ -f "$d/envy.lua" ]]; then
            # `if`, not `&&`: a failed test as the loop body's last command is a nonzero
            # body status, and `set -e` would take the whole script down on it.
            local is_root="true" key val
            while read -r key val || [[ -n "$key$val" ]]; do
                if [[ "$key" == "root" && "$val" == "false" ]]; then is_root="false"; fi
            done < <(manifest_directives "$d/envy.lua")
            if [[ "$is_root" == "true" ]]; then
                echo "$d/envy.lua" && return
            else
                candidates+=("$d/envy.lua")
            fi
        fi
        # A repository is a hard boundary, matching discover() in src/manifest.cpp. Without
        # it a `root "false"` project inside a checkout kept walking into the parent tree,
        # and the launcher and the binary picked different manifests -- so different caches.
        if [[ -d "$d/.git" ]]; then break; fi
        d="${d%/*}"; d="${d:-/}"
    done
    [[ ${#candidates[@]} -gt 0 ]] && echo "${candidates[${#candidates[@]}-1]}" && return
    return 1
}

ENVY_MANIFEST=$(find_manifest) || { echo "ERROR: envy.lua not found" >&2; exit 1; }

ENVY_VERSION="" ENVY_CACHE_LOCAL="" ENVY_CACHE_MODE="" ENVY_STATE_DIR_REL="" ENVY_MANIFEST_MIRROR="" ENVY_SUMS_PIN=""
# `|| [[ -n ... ]]`: sed reproduces a manifest's missing final newline, and a bare `read`
# returns nonzero on that unterminated last line -- dropping the directive on it. A manifest
# whose last line is `-- @envy sha256sums "..."` would then bootstrap with no pin at all.
while read -r ENVY_KEY ENVY_VAL || [[ -n "$ENVY_KEY$ENVY_VAL" ]]; do
    ENVY_VAL="${ENVY_VAL//\\\"/\"}"
    ENVY_VAL="${ENVY_VAL//\\\\/\\}"
    case "$ENVY_KEY" in
        version) ENVY_VERSION="$ENVY_VAL" ;; cache-local) ENVY_CACHE_LOCAL="$ENVY_VAL" ;;
        cache-mode) ENVY_CACHE_MODE="$ENVY_VAL" ;;
        state-dir) ENVY_STATE_DIR_REL="$ENVY_VAL" ;;
        mirror) ENVY_MANIFEST_MIRROR="$ENVY_VAL" ;;
        sha256sums) ENVY_SUMS_PIN="$ENVY_VAL" ;;
    esac
done < <(manifest_directives "$ENVY_MANIFEST")
# A sums pin names one release's checksum file, so it is meaningless against a resolved or
# stamped-fallback version. Captured before the resolution chain overwrites ENVY_VERSION.
ENVY_PINNED_VERSION="$ENVY_VERSION"

# Fail closed before any network: a pin that silently stops verifying is worse than none,
# since the manifest still advertises attestation.
if [[ -n "$ENVY_SUMS_PIN" && -z "$ENVY_PINNED_VERSION" ]]; then
    echo "ERROR: '@envy sha256sums' requires '@envy version' in $ENVY_MANIFEST" >&2
    exit 1
fi

# Precedence: ENVY_MIRROR env > @envy mirror directive > envy upstream, matching the
# runtime resolver in src/reexec.cpp. ENVY_DEFAULT_MIRROR is always envy's own release ENVY_URL,
# never a copy of this project's mirror: deleting the directive must not resolve this
# script and the re-exec'd binary to different mirrors.
if [[ -n "$ENVY_ENV_MIRROR" ]]; then ENVY_MIRROR="$ENVY_ENV_MIRROR"
elif [[ -n "$ENVY_MANIFEST_MIRROR" ]]; then ENVY_MIRROR="$ENVY_MANIFEST_MIRROR"
else ENVY_MIRROR="$ENVY_DEFAULT_MIRROR"; fi

# A trailing slash would produce ".../releases//v1.2.3/...", a distinct and nonexistent
# s3:// key.
while [[ "$ENVY_MIRROR" == */ ]]; do ENVY_MIRROR="${ENVY_MIRROR%/}"; done

mirror_is_s3() { [[ "$ENVY_MIRROR" == s3://* || "$ENVY_MIRROR" == S3://* ]]; }

require_aws() {
    command -v aws >/dev/null 2>&1 || {
        echo "ERROR: mirror '$ENVY_MIRROR' is an s3:// URI but the aws CLI was not found" \
             "on PATH. Install AWS CLI v2, or use an https:// mirror." >&2
        exit 1
    }
}

# Streams one mirror object to stdout; non-zero if missing or unreadable. AWS region and
# credentials come from the environment/profile, as for any other AWS tool.
mirror_cat() {
    if mirror_is_s3; then
        require_aws
        aws s3 cp --only-show-errors "$1" -
    else
        curl -fsSL --connect-timeout 10 --max-time 300 "$1"
    fi
}

# sha256 of a file, lowercase hex, no filename. Each tier ships with some OS: sha256sum
# (coreutils), shasum (macOS), openssl. None available is a hard error, never a skip.
sha256_file() {
    if command -v sha256sum >/dev/null 2>&1; then sha256sum "$1" | cut -d' ' -f1
    elif command -v shasum >/dev/null 2>&1; then shasum -a 256 "$1" | cut -d' ' -f1
    elif command -v openssl >/dev/null 2>&1; then openssl dgst -sha256 "$1" | sed 's/^.*= *//'
    else
        echo "ERROR: '@envy sha256sums' is pinned but no sha256 tool was found (tried" \
             "sha256sum, shasum, openssl)" >&2
        return 1
    fi
}

# Compare hex case-insensitively; certutil and Get-FileHash emit uppercase. `if` rather
# than `[[ ]] && return`: a failing AND-list is a set -e footgun, and bash 3.2 has no
# ${var,,}.
hex_eq() {
    if [[ "$1" == "$2" ]]; then return 0; fi
    local a b
    a="$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')"
    b="$(printf '%s' "$2" | tr '[:upper:]' '[:lower:]')"
    [[ "$a" == "$b" ]]
}

# envy releases are numbered MAJOR.MINOR.PATCH; anything else from a network resolver is
# not a version. Clearing defers to the next tier, ultimately ENVY_FALLBACK_VERSION. A
# `vlatest/` ENVY_URL 404s, reported as a 403 by a bucket without s3:ListBucket.
keep_valid_version() {
    if [[ -n "$ENVY_VERSION" && ! "$ENVY_VERSION" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
        echo "WARNING: ignoring implausible envy version '$ENVY_VERSION' from $1" >&2
        ENVY_VERSION=""
    fi
}

ENVY_MANIFEST_DIR="${ENVY_MANIFEST%/*}"; ENVY_MANIFEST_DIR="${ENVY_MANIFEST_DIR:-/}"

# Ahead of the tiers, not inside the branch that fills them: these are ordinary env vars,
# so an exported value would survive into the override branch, unseen by `set -u`.
ENVY_MODE="" ENVY_SHARED_CACHE="" ENVY_MODE_FROM_MARKER=""

# Tiers, in order, matching resolve_cache_root() in src/cache.cpp. No expansion of any kind:
# every value here is either a literal from the manifest or a path this script joins, so
# there is no grammar for this script and the binary to disagree about.
if [[ -n "${ENVY_CACHE_ROOT:-}" ]]; then
    ENVY_CACHE="$ENVY_CACHE_ROOT"
    # Rejected rather than absolutized: the binary used to anchor a relative value to its
    # own cwd while this script took it verbatim, so one invocation named two trees.
    if [[ "$ENVY_CACHE" != /* ]]; then
        echo "ERROR: ENVY_CACHE_ROOT must be an absolute path: $ENVY_CACHE" >&2
        exit 1
    fi
else
    # The user's own cache root; a local tree borrows a binary from it read-only. Guarded
    # and empty when absent: an unguarded $HOME aborts under `set -u`.
    if [[ $(uname) == Darwin ]]; then
        # XDG_CACHE_HOME is not consulted on Darwin, matching platform_posix.cpp.
        if [[ -n "${HOME:-}" ]]; then ENVY_SHARED_CACHE="$HOME/Library/Caches/envy"; fi
    elif [[ -n "${XDG_CACHE_HOME:-}" ]]; then ENVY_SHARED_CACHE="$XDG_CACHE_HOME/envy"
    elif [[ -n "${HOME:-}" ]]; then ENVY_SHARED_CACHE="$HOME/.cache/envy"; fi

    # @envy state-dir, else the manifest's own directory -- never `.envy`, which is inside
    # the default local tree `.envy/cache` and would let a cache wipe erase the marker.
    if [[ -n "$ENVY_STATE_DIR_REL" ]]; then ENVY_STATE_DIR="$ENVY_MANIFEST_DIR/$ENVY_STATE_DIR_REL"
    else ENVY_STATE_DIR="$ENVY_MANIFEST_DIR"; fi

    # Existence is the whole signal, so there is no file content for this script, cmd.exe
    # and C++ to read three different ways.
    if [[ -f "$ENVY_STATE_DIR/.envy-cache-local" && -f "$ENVY_STATE_DIR/.envy-cache-shared" ]]; then
        echo "ERROR: both .envy-cache-local and .envy-cache-shared exist in $ENVY_STATE_DIR;" \
             "envy never writes both. Delete one." >&2
        exit 1
    fi

    # A marker leaves no directive behind, and a pre-marker envy cannot see it either --
    # remembered so the version guard below refuses that downgrade too.
    if [[ -f "$ENVY_STATE_DIR/.envy-cache-local" ]]; then ENVY_MODE=local; ENVY_MODE_FROM_MARKER=1
    elif [[ -f "$ENVY_STATE_DIR/.envy-cache-shared" ]]; then ENVY_MODE=shared; ENVY_MODE_FROM_MARKER=1
    elif [[ -n "$ENVY_CACHE_MODE" ]]; then ENVY_MODE="$ENVY_CACHE_MODE"
    elif [[ -n "$ENVY_CACHE_LOCAL" ]]; then ENVY_MODE=local   # naming a tree is asking for it
    else ENVY_MODE=shared; fi

    if [[ "$ENVY_MODE" == local ]]; then
        # Anchored to the manifest's directory, never the caller's cwd: one manifest names
        # one tree from every working directory, or an invocation from a subdirectory
        # refetches the whole package set into a tree of its own.
        ENVY_CACHE="$ENVY_MANIFEST_DIR/${ENVY_CACHE_LOCAL:-.envy/cache}"
    else ENVY_CACHE="$ENVY_SHARED_CACHE"; fi

    # Shared mode *is* the platform default, so with no HOME there is no root. This used to
    # be a bare "HOME: unbound variable" abort naming neither cause nor way out.
    if [[ -z "$ENVY_CACHE" ]]; then
        echo "ERROR: cannot determine a cache root: neither HOME nor XDG_CACHE_HOME is" \
             "set. Set ENVY_CACHE_ROOT, or give the project a local cache." >&2
        exit 1
    fi
fi

if [[ -z "$ENVY_VERSION" ]]; then
    if [[ -f "$ENVY_CACHE/envy/latest" ]]; then
        ENVY_LATEST_VER="$(cat "$ENVY_CACHE/envy/latest" 2>/dev/null)"
        ENVY_LATEST_VER="${ENVY_LATEST_VER%%[[:space:]]*}"
        [[ -n "$ENVY_LATEST_VER" && -x "$ENVY_CACHE/envy/$ENVY_LATEST_VER/envy" ]] && ENVY_VERSION="$ENVY_LATEST_VER"
    fi
    # Ask the mirror first: 'envy mirror-envy' writes a `latest` file at the mirror root,
    # so a private or air-gapped mirror answers for itself.
    if [[ -z "$ENVY_VERSION" ]]; then
        if ENVY_VERSION="$(mirror_cat "$ENVY_MIRROR/latest" 2>/dev/null)"; then
            ENVY_VERSION="${ENVY_VERSION//[[:space:]]/}"
            keep_valid_version "$ENVY_MIRROR/latest"
        else
            ENVY_VERSION=""  # a failed fetch leaves partial output behind
        fi
    fi
    # GitHub serves no `latest` object, so fall back to its redirect. Parse the end of the
    # chain, not hop 1: a repo rename inserts a hop whose last segment is `latest`. Skipped
    # for s3:// mirrors, which are never github. Timeouts bound a blackholed connect.
    if [[ -z "$ENVY_VERSION" ]] && ! mirror_is_s3; then
        # Gated on curl's status: --fail still writes the -w output on an HTTP error.
        if ENVY_EFFECTIVE="$(curl -fsSL -o /dev/null -w '%{url_effective}' \
            --connect-timeout 5 --max-time 15 "$ENVY_LATEST_URL" 2>/dev/null)"; then
            ENVY_GH="${ENVY_EFFECTIVE##*/}"; ENVY_VERSION="${ENVY_GH#v}"
            keep_valid_version "$ENVY_LATEST_URL"
        fi
    fi
    if [[ -z "$ENVY_VERSION" ]]; then
        ENVY_VERSION="$ENVY_FALLBACK_VERSION"
    fi
fi

# An older envy silently ignores the cache directives below and would resolve the *shared*
# cache for a manifest asking for a hermetic tree, then exit 0. Refuse before downloading it.
version_lt() {  # $1 < $2, both MAJOR.MINOR.PATCH
    local IFS=. a b i
    read -r -a a <<< "$1"
    read -r -a b <<< "$2"
    for i in 0 1 2; do
        if (( ${a[i]:-0} < ${b[i]:-0} )); then return 0; fi
        if (( ${a[i]:-0} > ${b[i]:-0} )); then return 1; fi
    done
    return 1
}

# 0.0.0 is a dev build, which reexec_should() in src/reexec.cpp also lets through: it is
# built from a working tree, so its directive support cannot be inferred from its version.
# The ENVY_MIN_DIRECTIVE_VERSION shape test matters too -- an unstamped template would otherwise
# reach bash arithmetic with '@@MIN_DIRECTIVE_VERSION@@' and die under set -e.
# ENVY_MODE_FROM_MARKER counts as much as a directive: `envy cache --local` leaves nothing
# in the manifest, and a pre-marker envy resolves the shared cache and exits 0.
if [[ -n "$ENVY_CACHE_LOCAL$ENVY_CACHE_MODE$ENVY_STATE_DIR_REL$ENVY_MODE_FROM_MARKER" \
      && "$ENVY_VERSION" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ && "$ENVY_VERSION" != 0.0.0 \
      && "$ENVY_MIN_DIRECTIVE_VERSION" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] \
   && version_lt "$ENVY_VERSION" "$ENVY_MIN_DIRECTIVE_VERSION"; then
    echo "ERROR: $ENVY_MANIFEST resolves its cache mode from '@envy cache-local'/'cache-mode'/" \
         "'state-dir' or an 'envy cache' marker, added in envy" \
         "$ENVY_MIN_DIRECTIVE_VERSION, but resolves envy $ENVY_VERSION. That envy ignores them and" \
         "would silently use the shared cache. Raise or remove the '@envy version' pin." >&2
    exit 1
fi

case "$(uname -s)" in
    Darwin) ENVY_PLATFORM=darwin ;; Linux) ENVY_PLATFORM=linux ;;
    *) echo "ERROR: Unsupported platform: $(uname -s)" >&2; exit 1 ;;
esac

case "$(uname -m)" in
    x86_64) ENVY_ARCH=x86_64 ;; aarch64|arm64) ENVY_ARCH=arm64 ;;
    *) echo "ERROR: Unsupported architecture: $(uname -m)" >&2; exit 1 ;;
esac

# --project, injected ahead of the caller's argv: this script belongs to one project, and
# the binary must not rediscover a different one from whatever CWD invoked it. take_last on
# the option side means a hand-typed --project still wins.
ENVY_ARGS=(--project "$(resolve_script_dir)")

ENVY_BIN="$ENVY_CACHE/envy/$ENVY_VERSION/envy"

# -f and -s as well as -x: [[ -x ]] passes a directory and a zero-length file that kept the
# bit, and exec then takes this script down with 126 rather than falling through.
usable_envy() { [[ -f "$1" && -s "$1" && -x "$1" ]]; }

# Selection, then one exec: a second `exec` after a failed first never runs. Skipped with a
# sums pin (the fast path never re-hashes) and under ENVY_CACHE_ROOT, where MODE is empty.
if ! usable_envy "$ENVY_BIN" &&
   [[ "$ENVY_MODE" == local && -z "$ENVY_SUMS_PIN" && -n "$ENVY_SHARED_CACHE" ]]; then
    ENVY_BIN="$ENVY_SHARED_CACHE/envy/$ENVY_VERSION/envy"
fi

if usable_envy "$ENVY_BIN"; then
    exec "$ENVY_BIN" "${ENVY_ARGS[@]}" "$@"
fi

echo "Downloading envy $ENVY_VERSION..." >&2
# mktemp, not $$: a predictable name in a sticky /tmp lets another user pre-create the
# directory we extract into and exec from.
ENVY_TMP_DIR="$(mktemp -d "${TMPDIR:-/tmp}/envy-XXXXXXXX")"
die() { echo "ERROR: $1" >&2; rm -rf "$ENVY_TMP_DIR"; exit 1; }
ENVY_ARCHIVE="envy-$ENVY_PLATFORM-$ENVY_ARCH.tar.gz"
ENVY_URL="$ENVY_MIRROR/v$ENVY_VERSION/$ENVY_ARCHIVE"

# To a file, not piped into tar: an unattested archive must never be unpacked, or a hostile
# mirror chooses the paths written under $ENVY_TMP_DIR, from which we exec.
mirror_cat "$ENVY_URL" > "$ENVY_TMP_DIR/$ENVY_ARCHIVE" || die "Failed to download envy from $ENVY_URL"

if [[ -n "$ENVY_SUMS_PIN" ]]; then
    ENVY_SUMS_URL="$ENVY_MIRROR/v$ENVY_VERSION/SHA256SUMS"
    mirror_cat "$ENVY_SUMS_URL" > "$ENVY_TMP_DIR/SHA256SUMS" || die "Failed to download $ENVY_SUMS_URL"

    # Anchor the chain on the manifest's pin before trusting anything the sums file says.
    ENVY_GOT="$(sha256_file "$ENVY_TMP_DIR/SHA256SUMS")" || { rm -rf "$ENVY_TMP_DIR"; exit 1; }
    hex_eq "$ENVY_GOT" "$ENVY_SUMS_PIN" || die "SHA256SUMS does not match the pinned '@envy sha256sums':
       expected $ENVY_SUMS_PIN
       got      $ENVY_GOT
       The mirror is serving a different release manifest than $ENVY_MANIFEST pinned.
       Update the pin deliberately; do not remove it."

    # Match this exact archive: keying on the hash alone accepts any platform's binary, and
    # a substring name match accepts a longer sibling.
    ENVY_WANT="$(sed -nE "s/^([0-9a-fA-F]{64})[[:space:]]+\*?${ENVY_ARCHIVE//./\\.}\$/\1/p" \
        "$ENVY_TMP_DIR/SHA256SUMS" | head -1)"
    [[ -n "$ENVY_WANT" ]] || die "SHA256SUMS lists no entry for $ENVY_ARCHIVE"

    ENVY_GOT="$(sha256_file "$ENVY_TMP_DIR/$ENVY_ARCHIVE")" || { rm -rf "$ENVY_TMP_DIR"; exit 1; }
    hex_eq "$ENVY_GOT" "$ENVY_WANT" || die "$ENVY_ARCHIVE failed attestation:
       SHA256SUMS says $ENVY_WANT
       downloaded      $ENVY_GOT"
fi

tar -xzf "$ENVY_TMP_DIR/$ENVY_ARCHIVE" -C "$ENVY_TMP_DIR" || die "Failed to extract envy from $ENVY_URL"
# tar exits 0 on an empty archive, so a zero-length object would fall through to a
# confusing "no such file" from exec.
[[ -f "$ENVY_TMP_DIR/envy" ]] || die "archive from $ENVY_URL contained no envy binary"
[[ $ENVY_PLATFORM == darwin ]] && xattr -d com.apple.quarantine "$ENVY_TMP_DIR/envy" 2>/dev/null || true
chmod +x "$ENVY_TMP_DIR/envy" && exec "$ENVY_TMP_DIR/envy" "${ENVY_ARGS[@]}" "$@"
