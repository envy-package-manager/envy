#!/usr/bin/env bash
# envy-managed schema "@@ENVY_PRODUCT_SCRIPT_VERSION@@"
SCRIPT_DIR="$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
# The bin dir is a fixed fact, so a product that shells out to a sibling product finds it.
export PATH="$SCRIPT_DIR:$PATH"
# The project root is not: deploy leaves the hop empty for an '@envy root "false"' manifest,
# whose project depends on where the tree is nested, and the caller's value stands.
ENVY_PROJECT_ROOT_HOP="@@PROJECT_ROOT_REL@@"
if [[ -n "$ENVY_PROJECT_ROOT_HOP" ]]; then
    ENVY_PROJECT_ROOT="$(cd -P "$SCRIPT_DIR/$ENVY_PROJECT_ROOT_HOP" && pwd -P)"
    export ENVY_PROJECT_ROOT
fi
# The sibling launcher injects --project with this directory, so envy resolves the project
# this script was deployed into rather than rediscovering one from the caller's CWD.
PRODUCT="$("$SCRIPT_DIR/envy" product "@@PRODUCT_NAME@@")" || exit $?
if [[ -z "$PRODUCT" ]]; then
    echo "envy: failed to resolve product '@@PRODUCT_NAME@@'" >&2
    exit 1
fi
exec "$PRODUCT" "$@"
