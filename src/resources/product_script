#!/usr/bin/env bash
# envy-managed schema "@@ENVY_PRODUCT_SCRIPT_VERSION@@"
set -Eeuo pipefail
ENVY_SCRIPT_DIR="$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
# The sibling launcher injects --project, so envy resolves the project this script was
# deployed into. `product --run` installs the tool if needed, activates the project unless
# the caller already is its current activation, and execs the tool in that environment.
exec "$ENVY_SCRIPT_DIR/envy" product --run "@@PRODUCT_NAME@@" -- "$@"
