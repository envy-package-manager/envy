#!/usr/bin/env bash
# envy-managed schema "@@ENVY_PRODUCT_SCRIPT_VERSION@@"
set -Eeuo pipefail
ENVY_SCRIPT_DIR=.
case "${BASH_SOURCE[0]}" in */*) ENVY_SCRIPT_DIR="${BASH_SOURCE[0]%/*}" ;; esac
# The launcher runs in this bash and adds --project. `product --run` installs the tool if
# needed and execs it in the project's activation.
. "$ENVY_SCRIPT_DIR/envy" product --run "@@PRODUCT_NAME@@" -- "$@"
