# ASan suppressions for third-party false positives
# See https://github.com/google/sanitizers/wiki/AddressSanitizerSuppressionLists
#
# Usage (automatic in build):
#   export ASAN_OPTIONS=suppressions=/path/to/envy/asan.supp
#   ./out/build/envy_unit_tests
#
# The build system sets this automatically via CMakeLists.txt
