import pathlib

# With mbedTLS and no CERT_LOCATION, libgit2's configure runs the build host's
# `openssl version -d` and compiles that machine's CA bundle path in as the default, which
# every git_libgit2_init then parses. envy sets its own CA certificates before any https
# fetch (libgit2_require_ssl_certs), so skip the probe: no default, and no openssl needed.

OLD = "\t\tif(NOT CERT_LOCATION)\n"
NEW = "\t\tif(FALSE) # envy: no default CA path from the build host\n"

path = pathlib.Path(r"@SELECT_HTTPS_PATH@")
text = path.read_text(encoding="utf-8")
if NEW not in text:
    if text.count(OLD) != 1:
        raise SystemExit(f"libgit2 cert location patch: expected one '{OLD.strip()}' in {path}")
    path.write_text(text.replace(OLD, NEW), encoding="utf-8")
