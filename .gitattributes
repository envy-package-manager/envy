src/resources/* eol=lf

# What `envy init` writes, mirrored here byte for byte. CRLF because cmd.exe resolves
# `goto`/`call :label` by seeking and computes those offsets as if every line ended CRLF:
# an LF-only batch drifts a byte per line until the search walks past the label -- "The
# system cannot find the batch label specified", after which the launcher parses no @envy
# directives at all. The template stays LF above; util_write_script() converts on the way out.
examples/bin/envy.bat eol=crlf

# Known-answer digests over these bytes; a CRLF conversion on a Windows checkout would
# make every tree_hash fixture test fail there and nowhere else.
test_data/tree_hash/** -text
